#!/usr/bin/env bash
#
# logagent — control surface for the ai-terminal log agent.
#
# Every action the app performs over SSH maps to one subcommand here. Output of
# `status` is JSON so the app can parse it directly; everything else is quiet.
#
#   logagent status
#   logagent set --json '{"days":7,"logServices":["api"]}' [--purge]
#   logagent pause | resume
#   logagent notify "message" ['{"host":"h","service":"s"}']
#   logagent channels --json '{"telegram":{"token":"…","chatId":"…"}}'
#   logagent uninstall --yes

set -euo pipefail
. /opt/ai-terminal-logs/lib/common.sh
load_env

# ─────────────────────────────────────────────────────────────────────────────
cmd_status() {
  python3 - "$CONF" <<'PY'
import json, os, shutil, subprocess, sys

conf_path = sys.argv[1]
try:
    conf = json.load(open(conf_path))
except Exception:
    conf = {}

container = os.environ.get("PG_CONTAINER", "ai-terminal-logs")
pg_user = os.environ.get("PG_USER", "logagent")
pg_db = os.environ.get("PG_DB", "logs")


def sh(cmd: str) -> str:
    try:
        return subprocess.run(cmd, shell=True, capture_output=True,
                              text=True, timeout=25).stdout.strip()
    except Exception:
        return ""


def q(sql: str) -> str:
    return sh(f'docker exec -i {container} psql -U {pg_user} -d {pg_db} -qtAX -c "{sql}"')


def qi(sql: str, default: int = 0) -> int:
    try:
        return int(q(sql) or default)
    except ValueError:
        return default


# Discovery: what this machine could collect, whether or not it is selected.
discovered = []
pm2_raw = sh("pm2 jlist 2>/dev/null")
if pm2_raw:
    try:
        for p in json.loads(pm2_raw):
            env = p.get("pm2_env") or {}
            discovered.append({
                "name": p.get("name"),
                "kind": "pm2",
                "status": env.get("status"),
                "restarts": env.get("restart_time", 0),
            })
    except Exception:
        pass

for line in sh("docker ps --format '{{.Names}}|{{.Status}}'").splitlines():
    if "|" not in line:
        continue
    name, status = line.split("|", 1)
    if name == container:
        continue
    discovered.append({
        "name": name,
        "kind": "docker",
        "status": "unhealthy" if "unhealthy" in status else "running",
    })

selected = conf.get("logServices") or []
for item in discovered:
    item["enabled"] = item["name"] in selected

usage = shutil.disk_usage("/")
db_running = container in sh("docker ps --format '{{.Names}}'").splitlines()

# Why the collector is down, not just that it is. Without this the app can only
# say "not running" and the operator has to SSH in to learn anything — which is
# the workflow this whole agent exists to remove.
vector_state = sh("systemctl is-active vector") or "unknown"
collector_detail = ""
if vector_state != "active":
    # Order matters: check the config BEFORE the unit. A config that failed
    # validation leaves the collector deliberately unstarted, so systemd reports
    # a blameless "inactive (dead)" and its journal says nothing at all — the
    # real reason is only in the validation log.
    cfg_error = "/var/lib/ai-terminal/vector-config.error"
    if os.path.exists(cfg_error):
        collector_detail = ("the generated Vector config was rejected, so the "
                            "collector was never started:\n\n"
                            + open(cfg_error).read())
    elif not os.path.exists("/etc/vector/vector.toml"):
        collector_detail = ("no Vector config on this machine — "
                            "run: logagent reload")
    elif not sh("systemctl cat vector 2>/dev/null"):
        collector_detail = ("no vector service unit on this machine — "
                            "re-run the installer to add one")
    else:
        collector_detail = sh(
            "journalctl -u vector --no-pager --lines=6 -o cat 2>/dev/null"
        ) or sh("systemctl status vector --no-pager --lines=6 2>/dev/null")

print(json.dumps({
    "installed": True,
    "version": open("/opt/ai-terminal-logs/VERSION").read().strip()
               if os.path.exists("/opt/ai-terminal-logs/VERSION") else "unknown",
    "schemaVersion": qi("SELECT max(version) FROM schema_version;") if db_running else 0,
    "paused": conf.get("paused", True),
    "days": conf.get("days"),
    "timezone": os.environ.get("TZ_NAME", "UTC"),
    "dbPort": int(os.environ.get("PG_PORT", 0) or 0),
    "sources": conf.get("sources", {}),
    "logServices": selected,
    "metricsAll": True,
    "discovered": discovered,
    "collector": {
        "state": vector_state,
        "detail": collector_detail[:2000],
    },
    "health": {
        "database": db_running,
        "vector": vector_state == "active",
        "receiver": sh("systemctl is-active ai-terminal-receiver") == "active",
        "partitionTimer": sh("systemctl is-active ai-terminal-partitions.timer") == "active",
        "alertTimer": sh("systemctl is-active ai-terminal-alerts.timer") == "active",
        "rollupTimer": sh("systemctl is-active ai-terminal-rollup.timer") == "active",
        "probeTimer": sh("systemctl is-active ai-terminal-probes.timer") == "active",
        "clockSynced": sh("timedatectl show -p NTPSynchronized --value") == "yes",
    },
    "maintenance": {
        "lastCleanup": q("SELECT max(ts) FROM maintenance_log WHERE action='drop_partition';") or None,
        "partitionsThrough": q(
            "SELECT max(c.relname) FROM pg_class c "
            "JOIN pg_inherits i ON i.inhrelid=c.oid "
            "JOIN pg_class p ON p.oid=i.inhparent WHERE p.relname='log_entries';") or None,
        "recent": [r for r in q(
            "SELECT ts||' '||action||' '||coalesce(detail,'') FROM maintenance_log "
            "ORDER BY ts DESC LIMIT 5;").splitlines() if r],
    },
    "alerts": {
        "firing": qi("SELECT count(*) FROM alert_state WHERE state='firing';"),
        "rules": qi("SELECT count(*) FROM alert_rules WHERE enabled;"),
        "openErrorGroups": qi("SELECT count(*) FROM error_groups WHERE state='open';"),
        "channels": sorted(
            json.load(open("/etc/ai-terminal/channels.json")).keys()
            if os.path.exists("/etc/ai-terminal/channels.json") else []),
    },
    "stats": {
        "rows": qi("SELECT count(*) FROM log_entries;"),
        "dbBytes": qi("SELECT pg_database_size(current_database());"),
        "oldestRow": q("SELECT min(ts) FROM log_entries;") or None,
        "newestRow": q("SELECT max(ts) FROM log_entries;") or None,
        "freeDisk": usage.free,
        "totalDisk": usage.total,
    },
}))
PY
}

# ─────────────────────────────────────────────────────────────────────────────
cmd_set() {
  local patch="${1:-{\}}" purge="${2:-}" prev_days new_days

  prev_days=$(json_get "$CONF" days 0)

  python3 - "$CONF" "$patch" <<'PY'
import json, sys
path, patch = sys.argv[1], sys.argv[2]
conf = json.load(open(path))
for key, value in json.loads(patch).items():
    if key == "sources" and isinstance(value, dict):
        conf.setdefault("sources", {}).update(value)
    else:
        conf[key] = value
# Choosing retention is the act of configuring the agent, so it also unpauses.
if conf.get("days") and conf.get("logServices"):
    conf["paused"] = False
json.dump(conf, open(path, "w"), indent=2)
PY
  chmod 600 "$CONF"

  new_days=$(json_get "$CONF" days 0)

  if [ "$purge" = "--purge" ]; then
    pgq -c "TRUNCATE log_entries;" >/dev/null 2>&1 || true
    audit purge "operator requested"
  fi

  # Retention changes take effect NOW, not on the next timer run — a user who
  # lowers retention to reclaim disk expects the disk back immediately.
  if [ "$prev_days" != "$new_days" ]; then
    bash "$LIB_DIR/partitions.sh" >/dev/null 2>&1 || true
  fi

  # stdout only is discarded — this command's stdout must stay parseable JSON.
  # stderr is deliberately let through, because that is where "vector is NOT
  # running" is reported, and a set that silently collects nothing is the whole
  # failure this agent exists to prevent. The app reads the same fact from
  # `health.vector` in the status below.
  bash "$LIB_DIR/vector-config.sh" >/dev/null \
    || warn "collection did not start — see above, then: logagent reload"
  cmd_status
}

# ─────────────────────────────────────────────────────────────────────────────
cmd_channels() {
  local patch="${1:-{\}}"
  install -d -m 700 "$ETC"
  [ -f "$CHANNELS" ] || echo '{}' > "$CHANNELS"

  python3 - "$CHANNELS" "$patch" <<'PY'
import json, sys
path, patch = sys.argv[1], sys.argv[2]
cfg = json.load(open(path))
for key, value in json.loads(patch).items():
    if isinstance(value, dict):
        cfg.setdefault(key, {}).update(value)
    else:
        cfg[key] = value
json.dump(cfg, open(path, "w"), indent=2)
PY
  chmod 600 "$CHANNELS"
  echo '{"ok":true}'
}

# Rule management. Rules target services by pattern, never by name, so a service
# deployed tomorrow inherits every rule without being registered anywhere.
cmd_alerts() {
  case "${1:-list}" in
    list)
      pgq -c "SELECT coalesce(json_agg(row_to_json(r)),'[]') FROM (
                SELECT a.id, a.name, a.kind, a.threshold, a.window_secs,
                       a.enabled, a.silenced_until, a.channels,
                       (SELECT count(*) FROM alert_state s
                          WHERE s.rule_id = a.id AND s.state = 'firing') AS firing
                FROM alert_rules a ORDER BY a.id) r;"
      ;;
    coverage)
      # Log rules only cover services with logging enabled. A half-monitored
      # service must never display as fully covered.
      python3 "$LIB_DIR/alerts.py" --coverage
      ;;
    events)
      pgq -c "SELECT coalesce(json_agg(row_to_json(e)),'[]') FROM (
                SELECT e.ts, e.service, e.host, e.value, e.state, r.name, r.kind
                FROM alert_events e LEFT JOIN alert_rules r ON r.id = e.rule_id
                ORDER BY e.ts DESC LIMIT ${2:-100}) e;"
      ;;
    firing)
      pgq -c "SELECT coalesce(json_agg(row_to_json(s)),'[]') FROM (
                SELECT s.service, s.since, r.name, r.kind
                FROM alert_state s JOIN alert_rules r ON r.id = s.rule_id
                WHERE s.state = 'firing' ORDER BY s.since DESC) s;"
      ;;
    set)      python3 "$LIB_DIR/alert-rule.py" "${2:?rule id required}" "${3:?json patch required}" ;;
    # add/delete go through the same allowlisted builder as `set`, which is the
    # only place permitted to turn user input into SQL against this table.
    add)      python3 "$LIB_DIR/alert-rule.py" --create "${2:?json rule required}" ;;
    delete)   python3 "$LIB_DIR/alert-rule.py" --delete "${2:?rule id required}" ;;
    kinds)
      # What the evaluator can actually run, straight from its dispatch table.
      # The app builds its rule-type picker from this instead of hard-coding a
      # list that could drift into offering a kind nothing evaluates.
      python3 -c "import sys; sys.path.insert(0, '$LIB_DIR');
import json; from alerts import CONDITIONS, MESSAGES
print(json.dumps([{'kind': k, 'describes': MESSAGES.get(k, '')} for k in sorted(CONDITIONS)]))"
      ;;
    silence)  pgq -c "UPDATE alert_rules SET silenced_until = now() + interval '${3:-60} minutes'
                      WHERE id = ${2:?rule id required};" >/dev/null && echo '{"ok":true}' ;;
    unsilence) pgq -c "UPDATE alert_rules SET silenced_until = NULL
                       WHERE id = ${2:?rule id required};" >/dev/null && echo '{"ok":true}' ;;
    run)      python3 "$LIB_DIR/alerts.py" ;;
    *) die "usage: logagent alerts {list|firing|coverage|kinds|events [n]|add '<json>'|set <id> '<patch>'|delete <id>|silence <id> [min]|unsilence <id>|run}" ;;
  esac
}

# Exception triage. Ignoring a group also stops it feeding the error-rate alert —
# otherwise the ignore button would be a lie and people stop trusting it.
cmd_errors() {
  case "${1:-list}" in
    list)
      local filter="AND state <> 'ignored'"
      [ "${2:-}" = "all" ] && filter=""
      pgq -c "SELECT coalesce(json_agg(row_to_json(g)),'[]') FROM (
                SELECT fp, service, host, severity, sample, first_seen, last_seen,
                       occurrences, state
                FROM error_groups WHERE true $filter
                ORDER BY last_seen DESC LIMIT ${3:-100}) g;"
      ;;
    state)
      case "${3:-}" in
        open|ignored|resolved) ;;
        *) die "state must be open, ignored or resolved" ;;
      esac
      pgq -c "UPDATE error_groups SET state = '$3'
              WHERE fp = '${2:?fingerprint required}';" >/dev/null
      echo '{"ok":true}'
      ;;
    *) die "usage: logagent errors {list [all] [limit]|state <fp> <open|ignored|resolved>}" ;;
  esac
}

cmd_pause() {
  systemctl stop vector >/dev/null 2>&1 || true
  python3 -c "
import json,sys
p=sys.argv[1]; c=json.load(open(p)); c['paused']=True
json.dump(c, open(p,'w'), indent=2)" "$CONF"
  audit paused "operator requested"
  echo '{"paused":true}'
}

cmd_resume() {
  python3 -c "
import json,sys
p=sys.argv[1]; c=json.load(open(p)); c['paused']=False
json.dump(c, open(p,'w'), indent=2)" "$CONF"
  systemctl start vector >/dev/null 2>&1 || warn "vector failed to start"
  audit resumed "operator requested"
  echo '{"paused":false}'
}

# Clearing the read positions is the recovery for a source that a rotation left
# behind: the collector holds an offset from the pre-rotation file and waits for
# the new, smaller one to grow past it, which for a daily rotation never happens.
# It is a command rather than an instruction because the path it has to delete is
# an internal detail nobody should be asked to know, and guessing it wrong (as
# happened once) wastes a whole round trip on a machine that is losing logs.
cmd_rewind() {
  local dir="$STATE/vector" n=0
  systemctl stop vector >/dev/null 2>&1 || true

  if [ -d "$dir" ]; then
    n=$(find "$dir" -name 'checkpoints.json*' -type f -print -delete 2>/dev/null | wc -l)
  fi

  systemctl start vector >/dev/null 2>&1 || true
  if systemctl is-active --quiet vector; then
    log "cleared $n checkpoint file(s); collection restarts at the end of each log"
  else
    warn "checkpoints cleared but vector is NOT running — logagent doctor"
  fi

  audit rewind "cleared $n checkpoint file(s)"
  printf '{"cleared":%s}\n' "$n"
}

cmd_uninstall() {
  [ "${1:-}" = "--yes" ] || die "refusing without --yes"

  local freed
  freed=$(pgq -c "SELECT pg_database_size(current_database());" 2>/dev/null || echo 0)

  systemctl disable --now vector ai-terminal-receiver \
    ai-terminal-partitions.timer ai-terminal-watchdog.timer \
    ai-terminal-metrics.timer ai-terminal-rollup.timer \
    ai-terminal-alerts.timer ai-terminal-probes.timer >/dev/null 2>&1 || true

  docker rm -f "$PG_CONTAINER"   >/dev/null 2>&1 || true
  docker volume rm "$PG_VOLUME"  >/dev/null 2>&1 || true

  rm -f /etc/systemd/system/ai-terminal-*.service /etc/systemd/system/ai-terminal-*.timer
  rm -f "$VECTOR_CONF"
  rm -rf "$STATE" /opt/ai-terminal-logs

  # Credentials last and unconditionally. Leaving FCM keys, SMTP passwords or the
  # database password behind is the worst possible outcome of an uninstall.
  rm -rf "$ETC"

  systemctl daemon-reload >/dev/null 2>&1 || true
  rm -f /usr/local/bin/logagent

  echo "{\"uninstalled\":true,\"freedBytes\":${freed:-0}}"
}

# ─────────────────────────────────────────────────────────────────────────────
case "${1:-status}" in
  status)    cmd_status ;;
  set)       shift; [ "${1:-}" = "--json" ] && shift; cmd_set "${1:-}" "${2:-}" ;;
  channels)  shift; [ "${1:-}" = "--json" ] && shift; cmd_channels "${1:-}" ;;
  notify)    shift; python3 "$LIB_DIR/notify.py" "${1:-test}" "${2:-{\}}" ;;
  pause)     cmd_pause ;;
  resume)    cmd_resume ;;
  alerts)    shift; cmd_alerts "$@" ;;
  errors)    shift; cmd_errors "$@" ;;
  doctor)    bash "$LIB_DIR/doctor.sh" ;;
  tail)      shift; exec bash "$LIB_DIR/tail.sh" "$@" ;;
  probe)     bash "$LIB_DIR/probes.sh" ;;
  rollup)    shift; bash "$LIB_DIR/rollup.sh" "$@" ;;
  reload)    bash "$LIB_DIR/vector-config.sh" ;;
  rewind)    cmd_rewind ;;
  maintain)  bash "$LIB_DIR/partitions.sh" ;;
  uninstall) shift; cmd_uninstall "${1:-}" ;;
  version)   cat /opt/ai-terminal-logs/VERSION 2>/dev/null || echo unknown ;;
  *)
    cat >&2 <<'USAGE'
usage: logagent <command>

  tail [service...]             live tail of EVERY service, unstored, unfiltered
                                by the log selection — Ctrl-C to stop
  doctor                        why the agent is or is not collecting, in full
  status                        JSON: config, discovered services, health, stats
  set --json '<patch>' [--purge]  merge config; retention changes apply immediately
  channels --json '<patch>'     configure fcm / telegram / smtp
  alerts <sub>                  list | firing | coverage | kinds | events
                                add | set | delete | silence | unsilence | run
  errors <sub>                  list [all] | state <fp> <open|ignored|resolved>
  probe                         run database and certificate probes now
  rollup [--backfill <days>]    recompute rollups and error groups now.
                                --backfill also recomputes HISTORY, which is
                                what fills charts that start abruptly on the
                                day the agent last learned something new
  notify "<message>" ['<data>'] send a test alert through every channel
  pause | resume                stop or start collection (data retained)
  reload                        regenerate vector config
  rewind                        forget where the collector is reading in every
                                log file and start from the end of each. Fixes a
                                source stuck behind a rotation. Nothing already
                                stored is lost; nothing missed is recovered
  maintain                      run partition maintenance now
  uninstall --yes               remove everything, credentials included
  version
USAGE
    exit 1
    ;;
esac

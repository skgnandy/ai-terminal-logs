[Unit]
Description=ai-terminal watchdog (stalled collector, emergency retention shrink)
Documentation=https://github.com/skgnandy/ai-terminal-logs
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
EnvironmentFile=/etc/ai-terminal/env
ExecStart=/bin/bash /opt/ai-terminal-logs/lib/watchdog.sh

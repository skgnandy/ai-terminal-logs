# Everything in this repo is executed on Linux. CRLF line endings would break
# shell scripts with "bad interpreter: /bin/bash^M", so force LF regardless of
# the platform the commit was authored on.
* text=auto eol=lf

*.sh    text eol=lf
*.py    text eol=lf
*.sql   text eol=lf
*.service text eol=lf
*.timer   text eol=lf
bin/logagent text eol=lf
install.sh   text eol=lf
VERSION      text eol=lf

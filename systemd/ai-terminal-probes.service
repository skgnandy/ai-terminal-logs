[Unit]
Description=ai-terminal active probes (database internals, TLS certificates)
Documentation=https://github.com/skgnandy/ai-terminal-logs
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
EnvironmentFile=/etc/ai-terminal/env
ExecStart=/bin/bash /opt/ai-terminal-logs/lib/probes.sh
TimeoutStartSec=600
